# Copia este archivo como .env y completa solo las credenciales que usarás.
# Nunca guardes valores reales en este archivo ni los confirmes en Git.

# Proveedor principal y cadena de fallback.
AI_PROVIDER=gemini
AI_FALLBACK_ORDER=gemini,groq,xai,kimi,deepseek_api
LLM_FALLBACKS_ENABLED=true

# Credenciales cloud. Configura al menos el proveedor principal.
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=

# Oracle puede usar GROQ_API_KEY como respaldo si esta variable queda vacía.
ORACLE_API_KEY=

# El baseline detectó que el modelo Groq por defecto ya no está disponible.
# Define aquí un modelo vigente habilitado para tu cuenta antes de usar Groq.
# GROQ_MODEL=replace-with-a-current-supported-model
# ORACLE_MODEL=replace-with-a-current-supported-model

# Backend local opcional. Si se usa, inclúyelo explícitamente en AI_FALLBACK_ORDER.
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434
# OLLAMA_MODEL_NAME=deepseek-r1:8b

# Datos locales de Chroma.
CHROMA_DB_PATH=./lazzaro_data
