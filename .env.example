# Copia este archivo como .env y completa solo las credenciales que usarás.
# Nunca guardes valores reales en este archivo ni los confirmes en Git.

# Perfil recomendado para esta instalación: solo Gemini, sin fallbacks remotos.
AI_PROVIDER=gemini
AI_FALLBACK_ORDER=gemini
LLM_FALLBACKS_ENABLED=false
LLM_TOTAL_BUDGET_SECONDS=45

# Credencial activa.
GEMINI_API_KEY=

# Los proveedores remotos adicionales quedan retirados. El Oráculo usa el
# cliente LLM activo como fallback cuando ORACLE_API_KEY no está configurada.
# No agregues GROQ_API_KEY, XAI_API_KEY, KIMI_API_KEY, DEEPSEEK_API_KEY ni
# ORACLE_API_KEY salvo que se apruebe explícitamente reactivar otro proveedor.

# Backend local opcional. Si se usa, inclúyelo explícitamente en AI_FALLBACK_ORDER.
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434
# OLLAMA_MODEL_NAME=deepseek-r1:8b

# Datos locales de Chroma.
CHROMA_DB_PATH=./lazzaro_data

# ROOT-029 — HUMAN_CONFIG_REQUIRED: sin estos cinco valores completos, toda
# acción física ligada a percepción queda INDETERMINATE y no se despacha.
# ROOT-029 no congela IDs, umbrales ni generation mode productivos.
# PERCEPTION_FRESHNESS_POLICY_ID=
# PERCEPTION_MAX_CAPTURE_AGE_MS=
# PERCEPTION_MAX_FUTURE_SKEW_MS=
# PERCEPTION_AUTHORITY_POLICY_ID=
# PERCEPTION_GENERATION_BINDING_MODE=
